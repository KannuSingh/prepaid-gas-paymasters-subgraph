{
  "name": "prepaid-gas-paymasters",
  "version": "1.0.0",
  "description": "The Graph subgraph for indexing paymaster events and activity from the Prepaid Gas paymaster system",
  "license": "MIT",
  "author": "Karandeep Singh",
  "repository": {
    "type": "git",
    "url": "https://github.com/KannuSingh/prepaid-gas-paymasters-subgraph.git"
  },
  "homepage": "https://github.com/KannuSingh/prepaid-gas-paymasters-subgraph#readme",
  "bugs": {
    "url": "https://github.com/KannuSingh/prepaid-gas-paymasters-subgraph/issues"
  },
  "keywords": [
    "subgraph",
    "the-graph",
    "paymaster",
    "account-abstraction",
    "erc-4337",
    "ethereum",
    "privacy",
    "zero-knowledge"
  ],
  "scripts": {
    "generate-config": "node scripts/generate-config.js",
    "codegen": "node scripts/codegen.js",
    "codegen:base-sepolia": "node scripts/codegen.js base-sepolia",
    "codegen:base": "node scripts/codegen.js base",
    "codegen:ethereum": "node scripts/codegen.js ethereum",
    "build": "graph build",
    "deploy": "graph deploy --node https://api.studio.thegraph.com/deploy/ prepaid-gas-paymasters",
    "create-local": "graph create --node http://localhost:8020/ prepaid-gas-paymasters",
    "remove-local": "graph remove --node http://localhost:8020/ prepaid-gas-paymasters",
    "deploy-local": "graph deploy --node http://localhost:8020/ --ipfs http://localhost:5001 prepaid-gas-paymasters",
    "test": "graph test"
  },
  "dependencies": {
    "@graphprotocol/graph-cli": "0.97.1",
    "@graphprotocol/graph-ts": "0.37.0",
    "@prepaid-gas/constants": "^0.0.6"
  },
  "devDependencies": {
    "matchstick-as": "0.6.0"
  }
}
